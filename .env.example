# API
NODE_ENV=development
PORT=4000
API_PUBLIC_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/student_rental
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
DEMO_MODE=true
UPLOAD_DRIVER=local
UPLOAD_DIR=uploads
MAX_IMAGE_SIZE_MB=8
AVAILABILITY_REMINDER_DAYS=14
AVAILABILITY_STALE_DAYS=30
EXACT_LOCATION_ADMIN_ONLY=true

# Mobile (use the computer LAN address on a physical device)
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
EXPO_PUBLIC_DEMO_MODE=true
EXPO_PUBLIC_DEFAULT_COUNTRY_CODE=+237

