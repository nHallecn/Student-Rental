{
  "expo": {
    "name": "Campus Homes Cameroon",
    "slug": "campus-homes-cameroon",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "campushomes",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "cm.campushomes.app"
    },
    "android": {
      "package": "cm.campushomes.app",
      "adaptiveIcon": {
        "backgroundColor": "#F4F7F2"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Campus Homes to use your location when adding a property or measuring distance from a university."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Campus Homes to select rental property photos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "replace-with-your-eas-project-id"
      }
    }
  }
}

